rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pengaturan & inventaris sarpras:
    // Baca diizinkan untuk operasional tampilan aplikasi sekolah
    // Modifikasi hanya diizinkan untuk pengguna yang terotentikasi (staf/admin)
    match /asets/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /peminjamans/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /pemusnahans/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /pengaturan/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /bhp/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /pengambilan_bhp/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /audit_logs/{document} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
